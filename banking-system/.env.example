PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://admin:admin@localhost:5432/banking_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Worker retry behavior
MAX_RETRIES=3
RETRY_DELAY_MS=5000
WORKER_RECONNECT_MS=5000
QUEUE_RETRY_INTERVAL_MS=5000

# Empty value keeps notification delivery in mock/log mode.
# Set this to an HTTP endpoint to POST notification payloads to another service.
NOTIFICATION_WEBHOOK_URL=
